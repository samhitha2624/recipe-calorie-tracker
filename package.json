{
  "name": "recipe-calorie-tracker",
  "version": "0.1.0",
  "description": "Share recipes, see calories per serving from USDA data, and track daily calories.",
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "prisma generate && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samhitha2624/recipe-calorie-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/samhitha2624/recipe-calorie-tracker/issues"
  },
  "homepage": "https://github.com/samhitha2624/recipe-calorie-tracker#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
