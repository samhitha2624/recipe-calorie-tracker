{
  "name": "recipe-calorie-tracker",
  "version": "0.1.0",
  "description": "A private app for your recipes, calories per serving, and a daily food log. Runs on Firebase.",
  "scripts": {
    "dev": "vite",
    "dev:local": "firebase emulators:exec --project demo-recipe-calories --only auth,firestore \"vite --mode emulators\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit && npm run test:rules",
    "test:rules": "firebase emulators:exec --project demo-recipe-calories --only firestore \"vitest run --project rules\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samhitha2624/recipe-calorie-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/samhitha2624/recipe-calorie-tracker/issues"
  },
  "homepage": "https://github.com/samhitha2624/recipe-calorie-tracker#readme",
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
